function answer(choice) {
  const score = document.getElementById("score");

  if (choice === "A") {
    score.textContent = "🎉 Correct! Apple starts with A.";
    score.style.color = "green";
  } else {
    score.textContent = "😊 Try again! Think of Apple...";
    score.style.color = "#d26a00";
  }
}
