function readStory(title) {
  const stories = {
    "The Brave Little Rabbit":
      "Once there was a little rabbit who was afraid of the dark. One evening, a friend needed help finding the way home. The rabbit took a deep breath, followed the moonlight, and discovered that being brave means trying even when you feel afraid.",

    "Lulu and the Lion":
      "Lulu met a friendly lion who looked scary at first. She smiled, shared her snack, and asked his name. Soon they were laughing together. Lulu learned that kindness can turn a stranger into a friend.",

    "The Magic Tree":
      "Mia found a tree covered in sparkling leaves. Every time she shared something with someone, a new leaf appeared. By sunset the tree was glowing, and Mia learned that sharing makes happiness grow."
  };

  alert(title + "\n\n" + (stories[title] || "A wonderful story is coming soon!"));
}

